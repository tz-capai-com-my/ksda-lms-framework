# Public Supabase project settings for THIS deployment only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional current mission readings: keep false for the default fallback lessons.
# Enable only after compatible schema and matching sealed content are installed,
# independently reviewed, explicitly approved and activated in YOUR own backend.
# Also requires config/brand.json features.readingCompanions=true.
KSDA_READING_DELIVERY_ENABLED=false
# Server-only allowlist. Empty means no administrator access.
LMS_ADMIN_EMAILS=
# Optional signed read-only admin-report Edge Function on the same Supabase project.
LMS_LEARNER_REPORT_URL=
LMS_LEARNER_REPORT_SECRET=
# Keep the service role key ONLY in Supabase Edge Function secrets, never here/client code.
